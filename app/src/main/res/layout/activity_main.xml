<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:orientation="vertical">

    <TextView
        android:id="@+id/app_bar_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:text="Стрічка"
        android:textColor="@color/diia_black"
        android:textSize="58sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/feed_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Привіт, Андрій 👋" android:textColor="@color/diia_black" android:textSize="24sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/home_notice" android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Незламність" android:textColor="@color/diia_black" android:textSize="22sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Мапа укриттів, Пунктів незламності та відділень Power Banking.\nЗаява про відсутній зв'язок." android:textColor="@color/diia_black" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Сканер" android:textSize="14sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Військові\nоблігації" android:textSize="14sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Відсутній\nзвʼязок" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="140dp" android:layout_marginTop="18dp" android:background="@drawable/card_surface" android:gravity="bottom" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ЛІНІЯ ДРОНІВ" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/documents_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <FrameLayout android:layout_width="match_parent" android:layout_height="680dp" android:layout_marginTop="22dp" android:background="@drawable/doc_background" android:padding="18dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Паспорт громадянина\nУкраїни" android:textSize="26sp" android:textColor="@color/diia_black"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="18dp" android:orientation="horizontal">
                            <TextView android:layout_width="160dp" android:layout_height="match_parent" android:background="@drawable/doc_photo_placeholder" android:gravity="center" android:text="Фото"/>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:text="Дата\nнародження:\n23.06.2009\n\nНомер:\nХХХХХХ" android:textSize="18sp"/>
                        </LinearLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="10dp" android:background="#9BE49A" android:gravity="center_vertical" android:singleLine="true" android:text="Документ оновлено о 19:45 | 14.05.2026 • Документ оновлено"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Комаровський\nМикита\nОлександрович" android:textSize="22sp"/>
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="160dp" android:layout_marginTop="16dp" android:background="@drawable/doc_action_pill" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⊕" android:textSize="48sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Додати документ" android:textSize="20sp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/services_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Сервіси" android:textSize="56sp" android:textColor="@color/diia_black"/>
                <TextView android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:background="@drawable/doc_action_pill" android:gravity="center_vertical" android:paddingStart="16dp" android:text="Пошук" android:textColor="#AAAAAA" android:textSize="22sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingExtra="16dp" android:text="Допомога армії      Незламність\nДія.Картка          Військові облігації\nЛінія дронів        Національний кешбек\nЧатбот єВорог       єВідновлення\nМіжнародний Реєстр збитків  Ветеранський спорт\nВодієві             Місце проживання\nОпитування          Допомога від держави\nШлюб онлайн         Послуги для ВПО\nПідприємцю          Допомога по безробіттю\nСудові послуги      єОселя\nВиконавчі провадження Довідки та витяги" android:textSize="16sp"/>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/menu_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Меню" android:textSize="56sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Версія Дії: 4.32.1.2628" android:textSize="14sp" android:textColor="@color/diia_text_secondary"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/menu_group_surface" android:padding="20dp" android:text="Повідомлення\n\nДія.Підпис\nІсторія підписань\n\nНалаштування\nОновити застосунок\nПідключені пристрої\n\nСлужба підтримки\nКопіювати номер пристрою\nПитання та відповіді" android:textSize="18sp"/>
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:background="@drawable/bottom_bar_diia"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/tab_feed" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/tab_feed_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_tab_feed_selected"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Стрічка" android:textColor="#fff" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/tab_documents" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/tab_documents_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_tab_documents_unselected"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Документи" android:textColor="#fff" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/tab_services" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/tab_services_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_tab_services_unselected"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Сервіси" android:textColor="#fff" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/tab_menu" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/tab_menu_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_tab_menu_unselected_badge"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Меню" android:textColor="#fff" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
